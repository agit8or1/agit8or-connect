{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agit8or1/agit8or-connect/schemas/Scope.schema.json",
  "x-source": "openapi/openapi.yaml#/components/schemas/Scope",
  "type": "object",
  "required": [
    "scope",
    "risk"
  ],
  "properties": {
    "scope": {
      "type": "string",
      "description": "Scope name, e.g. customers:read"
    },
    "risk": {
      "type": "string",
      "enum": [
        "read",
        "write",
        "high_risk",
        "admin"
      ]
    },
    "description": {
      "type": "string"
    },
    "available": {
      "type": "boolean"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
