{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agit8or1/agit8or-connect/schemas/QcDiscoveryAdditions.schema.json",
  "x-source": "openapi/openapi.yaml#/components/schemas/QcDiscoveryAdditions",
  "description": "Members a 1.1 installation adds to Discovery (ignored by 1.0 peers).",
  "type": "object",
  "properties": {
    "revision": {
      "type": "string",
      "const": "1.1"
    },
    "extensions": {
      "$ref": "QcExtensions.schema.json"
    },
    "endpoints": {
      "type": "object",
      "properties": {
        "qc_authorize": {
          "type": "string",
          "format": "uri",
          "description": "Browser page in the responder admin UI (same origin)"
        },
        "qc_exchange": {
          "type": "string",
          "format": "uri"
        },
        "qc_probe": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
