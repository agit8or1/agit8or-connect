{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agit8or1/agit8or-connect/schemas/TokenResponse.schema.json",
  "title": "Token endpoint answer (PROTOCOL.md §6.1)",
  "type": "object",
  "required": [
    "access_token",
    "token_type",
    "expires_in",
    "scope"
  ],
  "properties": {
    "access_token": {
      "type": "string"
    },
    "token_type": {
      "type": "string",
      "const": "DPoP"
    },
    "expires_in": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "scope": {
      "type": "string"
    }
  }
}
