{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agit8or1/agit8or-connect/schemas/QcAcceptClaims.schema.json",
  "x-source": "openapi/openapi.yaml#/components/schemas/QcAcceptClaims",
  "x-jws-typ": "agit8or-qc-accept+jwt",
  "description": "Payload of the accept JWS (typ agit8or-qc-accept+jwt, header jwk = K_B), returned through the browser redirect.",
  "type": "object",
  "required": [
    "protocol",
    "ext",
    "extensions",
    "iss",
    "aud",
    "iat",
    "exp",
    "attempt",
    "invitation",
    "invitation_sha256",
    "connection_id",
    "app",
    "base",
    "egress",
    "code_sha256"
  ],
  "properties": {
    "protocol": {
      "type": "string",
      "const": "agit8or-connect/1.1"
    },
    "ext": {
      "type": "string",
      "const": "qc-bootstrap/1"
    },
    "extensions": {
      "$ref": "QcExtensions.schema.json"
    },
    "iss": {
      "type": "string",
      "format": "uuid"
    },
    "aud": {
      "type": "string",
      "format": "uuid"
    },
    "iat": {
      "type": "integer"
    },
    "exp": {
      "type": "integer",
      "description": "exp - iat <= 600"
    },
    "attempt": {
      "type": "string",
      "format": "uuid"
    },
    "invitation": {
      "type": "string"
    },
    "invitation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "connection_id": {
      "type": "string",
      "format": "uuid"
    },
    "app": {
      "$ref": "QcApp.schema.json"
    },
    "base": {
      "type": "string",
      "maxLength": 512
    },
    "egress": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "EgressEntry.schema.json"
      }
    },
    "code_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
