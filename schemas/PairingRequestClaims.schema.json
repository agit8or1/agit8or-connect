{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agit8or1/agit8or-connect/schemas/PairingRequestClaims.schema.json",
  "title": "Pairing request (PROTOCOL.md §5.2)",
  "description": "Payload of a JWS with header typ \"agit8or-pairing-request+jwt\".",
  "x-jws-typ": "agit8or-pairing-request+jwt",
  "type": "object",
  "required": [
    "app",
    "aud",
    "connection_id",
    "connection_key",
    "discovery_url",
    "exp",
    "iat",
    "iss",
    "jti",
    "pairing_code",
    "proposed_tenants",
    "protocol",
    "requested_scopes"
  ],
  "properties": {
    "protocol": {
      "type": "string",
      "const": "agit8or-connect/1"
    },
    "iss": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "aud": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "iat": {
      "type": "integer"
    },
    "exp": {
      "type": "integer"
    },
    "jti": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "pairing_code": {
      "type": "string"
    },
    "app": {
      "type": "object",
      "required": [
        "type",
        "version",
        "display_name",
        "installation_id"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "installation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      }
    },
    "connection_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "discovery_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "connection_key": {
      "$ref": "OkpJwk.schema.json"
    },
    "requested_scopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proposed_tenants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    }
  }
}
