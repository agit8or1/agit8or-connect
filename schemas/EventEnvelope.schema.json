{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agit8or1/agit8or-connect/schemas/EventEnvelope.schema.json",
  "x-source": "openapi/openapi.yaml#/components/schemas/EventEnvelope",
  "type": "object",
  "required": [
    "id",
    "type",
    "tenant",
    "data",
    "sender"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,4}$"
    },
    "version": {
      "type": "integer"
    },
    "tenant": {
      "type": "string"
    },
    "data": {
      "type": "object"
    },
    "sender": {
      "type": "string"
    },
    "origin": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "causation_id": {
      "type": "string"
    },
    "hops": {
      "type": "integer",
      "minimum": 0
    },
    "idempotency_key": {
      "type": "string"
    },
    "occurred_at": {
      "type": "integer"
    }
  }
}
