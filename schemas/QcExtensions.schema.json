{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agit8or1/agit8or-connect/schemas/QcExtensions.schema.json",
  "x-source": "openapi/openapi.yaml#/components/schemas/QcExtensions",
  "description": "Extension name -> implemented versions. In discovery a single integer is also accepted.",
  "type": "object",
  "additionalProperties": {
    "oneOf": [
      {
        "type": "integer",
        "minimum": 1,
        "maximum": 999
      },
      {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        }
      }
    ]
  }
}
